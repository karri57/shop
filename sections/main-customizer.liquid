{%- comment -%}
  Interactive design studio.

  "Canvas" blocks each define a real garment - a name (matched by handle
  against the picker page's card names, so ?canvas=<handle> opens the
  right one), a product to sell, and up to four colorway name+photo
  pairs shown as swatches. Each colorway may carry an optional back
  photo so shoppers can design both sides. Shoppers place brand designs
  (uploaded as Design blocks) onto the photo.

  Layout: the garment is permanently visible and is the visual subject;
  the controls are stepped (design -> colour -> size -> review) so the
  shopper is guided rather than shown everything at once. The step nav
  lives at the top of the control panel rather than in its own column,
  so the panel can become a bottom sheet on phones without relocating
  any DOM across breakpoints.

  Add-to-cart posts the canvas's product with the design serialized
  into line item properties (visible on the order in Shopify admin).
{%- endcomment -%}

{%- liquid
  assign has_canvases = false
  assign has_designs = false
  for block in section.blocks
    if block.type == 'canvas'
      if block.settings.photo_1 != blank or block.settings.product != blank
        assign has_canvases = true
      endif
    elsif block.type == 'design' and block.settings.image != blank
      assign has_designs = true
    endif
  endfor
-%}

<ka-customizer class="page-width section kc">
  {%- if has_canvases -%}
    <script type="application/json" data-kc-config>
      {
        "designs": [
          { "key": "ka-monogram", "label": "KA", "text": "KA", "price": 0 },
          { "key": "create-your-legacy", "label": {{ 'sections.studio_showcase.statement' | t | json }}, "text": {{ 'sections.studio_showcase.statement' | t | json }}, "price": 0 },
          {% if settings.logo != blank %}{ "key": "signature-logo", "label": {{ 'sections.studio_showcase.signature' | t | json }}, "src": {{ settings.logo | image_url: width: 1000 | json }}, "price": 0 },{% endif %}
          {%- for block in section.blocks -%}
            {%- if block.type == 'design' and block.settings.image != blank -%}
              {
                "key": {{ block.settings.label | handleize | json }},
                "label": {{ block.settings.label | default: 'Design' | json }},
                "src": {{ block.settings.image | image_url: width: 500 | json }},
                "price": {{ block.settings.price | default: 0 | json }}
              },
            {%- endif -%}
          {%- endfor -%}
          {%- unless has_designs -%}
            {
              "key": "cross",
              "label": "Cross",
              "src": {{ 'custom-design-cross.svg' | asset_url | json }},
              "price": 0
            },
            {
              "key": "faith-over-fear",
              "label": "Faith over fear",
              "src": {{ 'custom-design-faith.svg' | asset_url | json }},
              "price": 0
            },
          {%- endunless -%}
          null
        ],
        "canvases": {% render 'studio-catalog' %},
        "feeVariant": {{ section.settings.fee_product.selected_or_first_available_variant.id | json }},
        "strings": { "proofError": {{ 'sections.studio_showcase.proof_error' | t | json }}, "attachmentError": {{ 'sections.studio_showcase.attachment_error' | t | json }} },
        "upload": {
          "cloud": {{ settings.design_upload_cloud | json }},
          "preset": {{ settings.design_upload_preset | json }}
        }
      }
    </script>

    <div class="kc__header">
      <a class="kc__back" href="/pages/create-your-own">{{ 'sections.customizer.change_garment' | t }}</a>
      <p class="kc__eyebrow">{{ 'sections.customizer.eyebrow' | t }}</p>
      <h1 class="kc__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="kc__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="kc__layout">
      <div class="kc__stage-column">
        <div class="kc__stage-meta">
          <div>
            <span>{{ 'sections.customizer.designing' | t }}</span>
            <strong data-kc-product-name></strong>
          </div>
          <button type="button" class="kc__reset" data-kc-reset hidden>
            {{ 'sections.customizer.reset' | t }}
          </button>
        </div>

        <div class="kc__stage" data-kc-stage>
          <div class="kc__garment-wrap" data-kc-frame>
            {%- assign initial_photo_rendered = false -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'canvas' and block.settings.product != blank or block.type == 'canvas' and block.settings.photo_1 != blank -%}
                {%- unless initial_photo_rendered -%}
                  {%- assign label_down = block.settings.label | downcase -%}
                  {%- assign fallback_asset = 'custom-tee.svg' -%}
                  {%- if label_down contains 'hoodie' -%}
                    {%- assign fallback_asset = 'custom-hoodie.svg' -%}
                  {%- elsif label_down contains 'polo' -%}
                    {%- assign fallback_asset = 'custom-polo.svg' -%}
                  {%- elsif label_down contains 'sweater' -%}
                    {%- assign fallback_asset = 'custom-sweater.svg' -%}
                  {%- endif -%}
                  {%- assign initial_photo_url = fallback_asset | asset_url -%}
                  {%- if block.settings.photo_1 != blank -%}{%- assign initial_photo_url = block.settings.photo_1 | image_url: width: 900 -%}{%- endif -%}
                  <img
                    src="{{ initial_photo_url }}"
                    alt="{{ block.settings.label | escape }}"
                    width="900"
                    height="1140"
                    class="kc__photo"
                    data-kc-photo
                    crossorigin="anonymous"
                    draggable="false"
                  >
                  {%- assign initial_photo_rendered = true -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
            <div class="kc__restricted" data-kc-restricted hidden></div>
            <div class="kc__placements" data-kc-placements></div>
          </div>

          {%- comment -%}
            Chrome floats over the stage so selecting a design never
            reflows the page, and so the garment keeps the full frame.
          {%- endcomment -%}
          <div class="kc__toggle kc__view-switch" role="tablist" aria-label="Side" data-kc-photo-view-group hidden>
            <button type="button" data-kc-view="front" aria-current="true">Front</button>
            <button type="button" data-kc-view="back" aria-current="false">Back</button>
          </div>

          <div class="kc__selection-tools" data-kc-tools hidden aria-hidden="true">
            <button type="button" data-kc-tool="smaller" aria-label="Smaller">&minus;</button>
            <button type="button" data-kc-tool="bigger" aria-label="Bigger">+</button>
            <button type="button" data-kc-tool="rotate-left" aria-label="Rotate left">&#8634;</button>
            <button type="button" data-kc-tool="rotate-right" aria-label="Rotate right">&#8635;</button>
            <button type="button" data-kc-tool="delete" aria-label="Remove design">{% render 'icon', name: 'delete' %}</button>
          </div>
        </div>
      </div>

      <div class="kc__panel" data-kc-panel>
        <div class="kc__product-summary">
          <div>
            <span class="kc__panel-label">{{ 'sections.customizer.your_piece' | t }}</span>
            <strong data-kc-panel-product></strong>
          </div>
          <span class="kc__product-price" data-kc-product-price></span>
        </div>

        <div class="kc__options">
          <section class="kc__option">
            <label for="StudioGarment-{{ section.id }}">{{ 'sections.studio_showcase.garment' | t }}</label>
            <select id="StudioGarment-{{ section.id }}" class="kc__garment-select" data-kc-garment></select>
          </section>
          <section class="kc__option">
            <div class="kc__option-heading">
              <span class="kc__option-number">01</span>
              <div>
                <h2>{{ 'sections.customizer.choose_motif' | t }}</h2>
                <p data-kc-selected-count>{{ 'sections.customizer.no_motif' | t }}</p>
              </div>
            </div>
            <div class="kc__designs" data-kc-designs>
              <p class="kc__empty" data-kc-designs-empty>
                {%- if request.design_mode -%}
                  {{ 'sections.customizer.designs_empty_merchant' | t }}
                {%- else -%}
                  {{ 'sections.customizer.designs_empty' | t }}
                {%- endif -%}
              </p>
            </div>
            <div class="kc__text-form">
              <label for="StudioText-{{ section.id }}">{{ 'sections.studio_showcase.your_words' | t }}</label>
              <input id="StudioText-{{ section.id }}" type="text" maxlength="32" placeholder="{{ 'sections.studio_showcase.text_placeholder' | t }}" data-kc-text>
              <label for="StudioInk-{{ section.id }}">{{ 'sections.studio_showcase.ink' | t }}</label>
              <select id="StudioInk-{{ section.id }}" data-kc-ink>
                <option value="#191919">{{ 'sections.studio_showcase.black' | t }}</option>
                <option value="#ffffff">{{ 'sections.studio_showcase.white' | t }}</option>
                <option value="#e4d6b8">{{ 'sections.studio_showcase.cream' | t }}</option>
              </select>
              <button type="button" class="button button--secondary" data-kc-add-text>{{ 'sections.studio_showcase.add_words' | t }}</button>
            </div>
            <p class="kc__hint">{{ 'sections.customizer.gesture_hint' | t }}</p>
          </section>

          <section class="kc__option" data-kc-color-group hidden>
            <div class="kc__option-heading">
              <span class="kc__option-number">02</span>
              <div>
                <h2>{{ 'sections.customizer.choose_color' | t }}</h2>
                <p data-kc-color-value></p>
              </div>
            </div>
            <div class="kc__colorways" data-kc-colorways></div>
          </section>

          <section class="kc__option" data-kc-size-group hidden>
            <div class="kc__option-heading">
              <span class="kc__option-number" data-kc-size-number>02</span>
              <div>
                <h2>{{ 'sections.customizer.step_size_heading' | t }}</h2>
                <p data-kc-size-value></p>
              </div>
            </div>
              <div class="kc__sizes" data-kc-sizes></div>
          </section>

          <section class="kc__option kc__review">
            <div class="kc__option-heading">
              <span class="kc__option-number" data-kc-review-number>03</span>
              <div>
                <h2>{{ 'sections.customizer.step_review_heading' | t }}</h2>
                <p>{{ 'sections.customizer.review_hint' | t }}</p>
              </div>
            </div>
            <dl class="kc__summary" data-kc-summary></dl>
          </section>
        </div>

        <div class="kc__actions">
          <button type="button" class="button button--full kc__add" data-kc-add hidden>
            <span>{{ 'products.product.add_to_cart' | t }}</span>
            <span class="kc__add-price" data-kc-price></span>
          </button>
          <p class="kc__note" data-kc-note hidden>
            {{ 'sections.customizer.no_product_note' | t }}
          </p>
          <p class="kc__note" data-kc-stock-note hidden>{{ 'sections.customizer.sold_out_note' | t }}</p>
          <p class="form-error" data-kc-error role="alert" aria-live="polite" hidden></p>
          <p class="visually-hidden" data-kc-status role="status" aria-live="polite"></p>
          <button type="button" class="link-underline kc__download" data-kc-download>{{ 'sections.studio_showcase.download' | t }}</button>
          <p class="kc__trust">{{ 'sections.customizer.trust_note' | t }}</p>
        </div>
      </div>
    </div>
  {%- else -%}
    {%- comment -%}
      Two audiences: never show theme-editor instructions to a shopper.
    {%- endcomment -%}
    <div class="kc__setup">
      {%- if request.design_mode -%}
        <h1 class="kc__title">{{ section.settings.heading }}</h1>
        <p class="kc__setup-text">{{ 'sections.customizer.setup_prompt' | t }}</p>
      {%- else -%}
        <h1 class="kc__title">{{ 'sections.customizer.empty_title' | t }}</h1>
        <p class="kc__setup-text">
          <a class="link-underline" href="{{ routes.all_products_collection_url }}">
            {{ 'sections.customizer.empty_link' | t }}
          </a>
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}
</ka-customizer>

<script src="{{ 'customizer.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .kc [hidden] { display: none !important; }
  .kc__garment-select, .kc__text-form input, .kc__text-form select { width: 100%; min-height: 44px; padding: 0.7rem; border: 1px solid #d8d8d2; background: #fff; color: #191919; }
  .kc__text-form { display: grid; gap: 0.6rem; margin-top: 1.2rem; }
  .kc__text-form label, .kc__option > label { display: block; margin-bottom: 0.4rem; font-size: 0.75rem; }
  .kc__design-art--lettering { background: #596052; }
  .kc__download { display: block; margin: 1rem auto; font-size: 0.75rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Design studio",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make it yours" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Choose a signature motif, place it your way, and create a piece that is only yours." },
    {
      "type": "header",
      "content": "Design pricing"
    },
    {
      "type": "product",
      "id": "fee_product",
      "label": "Customization fee product",
      "info": "Create a hidden product priced at exactly $1.00 (e.g. \"Customization fee\") and pick it here. When designs below carry a price, the studio adds this product at a quantity equal to the total fee, so the extra charge appears on the order. Without it, design prices are ignored."
    }
  ],
  "blocks": [
    {
      "type": "canvas",
      "name": "Canvas (garment)",
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "info": "Must match the card name on the picker page so clicking that card opens this garment.", "default": "Classic Tee" },
        { "type": "product", "id": "product", "label": "Product to sell", "info": "Added to cart with the shopper's design attached as line item properties. Leave empty to hide add-to-cart for this garment." },
        { "type": "header", "content": "Colorway 1" },
        { "type": "text", "id": "color_1_name", "label": "Name", "default": "Standard" },
        { "type": "image_picker", "id": "photo_1", "label": "Front photo", "info": "Required. Plain front-facing photo of this garment in this colorway." },
        { "type": "image_picker", "id": "photo_1_back", "label": "Back photo", "info": "Optional. Lets shoppers flip to the back to place designs there too." },
        { "type": "header", "content": "Colorway 2 (optional)" },
        { "type": "text", "id": "color_2_name", "label": "Name" },
        { "type": "image_picker", "id": "photo_2", "label": "Front photo" },
        { "type": "image_picker", "id": "photo_2_back", "label": "Back photo" },
        { "type": "header", "content": "Colorway 3 (optional)" },
        { "type": "text", "id": "color_3_name", "label": "Name" },
        { "type": "image_picker", "id": "photo_3", "label": "Front photo" },
        { "type": "image_picker", "id": "photo_3_back", "label": "Back photo" },
        { "type": "header", "content": "Colorway 4 (optional)" },
        { "type": "text", "id": "color_4_name", "label": "Name" },
        { "type": "image_picker", "id": "photo_4", "label": "Front photo" },
        { "type": "image_picker", "id": "photo_4_back", "label": "Back photo" },
        {
          "type": "header",
          "content": "Restricted area (optional)",
          "info": "Keep designs off part of this garment — a pocket, seam, zipper, or existing print. Shown to shoppers as a soft hatched zone; designs slide away from it automatically. Leave width or height at 0 to turn it off. Not sure of the numbers? Open your Zone picker page to drag a box on the real photo and read them off."
        },
        { "type": "range", "id": "noprint_x", "label": "Center — horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "noprint_y", "label": "Center — vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 20 },
        { "type": "range", "id": "noprint_w", "label": "Width", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 0 },
        { "type": "range", "id": "noprint_h", "label": "Height", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 0 }
      ]
    },
    {
      "type": "design",
      "name": "Design",
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "Logo" },
        { "type": "image_picker", "id": "image", "label": "Design image", "info": "Transparent PNGs work best." },
        {
          "type": "number",
          "id": "price",
          "label": "Extra charge (whole dollars)",
          "info": "Added per placement of this design. Requires the fee product in the section settings. 0 = free."
        }
      ]
    }
  ]
}
{% endschema %}
