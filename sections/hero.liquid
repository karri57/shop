<section
  class="editorial-hero editorial-hero--{{ section.settings.background }} editorial-hero--{{ section.settings.content_position }} editorial-hero--{{ section.settings.text_alignment }}{% if section.settings.image != blank %} editorial-hero--has-image{% endif %}"
  style="--hero-height-mobile: {{ section.settings.height_mobile }}px; --hero-height-desktop: {{ section.settings.height_desktop }}px;"
>
  {%- if section.settings.image != blank -%}
    <picture class="editorial-hero__media">
      {%- if section.settings.mobile_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ section.settings.mobile_image | image_url: width: 550 }} 550w, {{ section.settings.mobile_image | image_url: width: 900 }} 900w"
          sizes="100vw"
        >
      {%- endif -%}
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 1800 }} 1800w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="1800"
        height="{{ 1800 | divided_by: section.settings.image.aspect_ratio | default: 1200 }}"
        loading="{% if section.index == 1 %}eager{% else %}lazy{% endif %}"
        {% if section.index == 1 %}fetchpriority="high"{% endif %}
      >
    </picture>
    <div class="editorial-hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="editorial-hero__content page-width">
    <div class="editorial-hero__content-inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="editorial-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        {%- if section.settings.heading_tag == 'h1' -%}
          <h1 class="editorial-hero__heading">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h2 class="editorial-hero__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="editorial-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="editorial-button editorial-button--{{ section.settings.button_style }}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEW RELEASE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "COMING SOON" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP ALL" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "black", "label": "Black" },
        { "value": "white", "label": "White" }
      ],
      "default": "black"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "centered", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "centered"
    },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 320, "max": 900, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "height_desktop", "label": "Desktop height", "min": 400, "max": 1000, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 }
  ],
  "presets": [
    { "name": "Editorial hero" }
  ]
}
{% endschema %}
