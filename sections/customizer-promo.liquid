{%- liquid
  assign studio_url = section.settings.studio_link | default: '/pages/design-studio'
  assign hoodie = all_products['vintage-washed-frayed-hem-hoodie-8']
  assign tee = all_products['essential-cotton-t-shirt']
  assign varsity = all_products['two-tone-fleeced-varsity-jacket']
-%}
<section class="studio-editorial" aria-labelledby="HomeStudioTitle-{{ section.id }}">
  <div class="page-width">
    <div class="studio-editorial__heading">
      <div>
        <p class="studio-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 id="HomeStudioTitle-{{ section.id }}">{{ section.settings.heading_solid | escape }} <em>{{ section.settings.heading_outline | escape }}.</em></h2>
      </div>
      <p>{{ 'sections.studio_showcase.intro' | t }}</p>
    </div>
    <div class="studio-editorial__grid">
      {%- assign looks = 'signature-logo,ka-monogram,create-your-legacy' | split: ',' -%}
      {%- for look in looks -%}
        {%- liquid
          assign garment = hoodie
          assign colorway = 'brown'
          assign artwork_label = 'sections.studio_showcase.signature' | t
          if forloop.index == 2
            assign garment = varsity
            assign colorway = 'black-with-white'
            assign artwork_label = 'sections.studio_showcase.initials' | t
          elsif forloop.index == 3
            assign garment = tee
            assign colorway = 'navy-blue'
            assign artwork_label = 'sections.studio_showcase.words' | t
          endif
          assign canvas_key = garment.handle
          if forloop.first
            assign canvas_key = 'vintage-washed-frayed-hem-hoodie'
          endif
          assign garment_photo = garment.featured_image
          if forloop.first and section.settings.shirt_image != blank
            assign garment_photo = section.settings.shirt_image
          endif
        -%}
        <a class="studio-editorial__look studio-editorial__look--{{ forloop.index }}" href="{{ studio_url }}?canvas={{ canvas_key }}&colorway={{ colorway }}&motif={{ look }}&x={% if forloop.index == 2 %}38{% else %}50{% endif %}&y=40&scale={% if forloop.index == 2 %}0.65{% elsif forloop.index == 3 %}1.4{% else %}1{% endif %}">
          <div class="studio-editorial__image">
            <span class="studio-editorial__edition">0{{ forloop.index }} / {{ 'sections.studio_showcase.possibilities' | t }}</span>
            <div class="studio-editorial__frame" style="aspect-ratio: {{ garment_photo.aspect_ratio | default: 1 }}">
              {%- if garment_photo != blank -%}
                {{ garment_photo | image_url: width: 900 | image_tag: widths: '300,450,600,900', sizes: '(min-width: 750px) 32vw, 85vw', loading: 'lazy', class: 'studio-editorial__garment', alt: garment.title }}
              {%- endif -%}
              <div class="studio-editorial__art studio-editorial__art--{{ forloop.index }}" aria-hidden="true">
                {%- if forloop.first and settings.logo != blank -%}
                  {{ settings.logo | image_url: width: 600 | image_tag: alt: '', loading: 'lazy' }}
                {%- elsif forloop.index == 2 -%}
                  KA
                {%- else -%}
                  {{ 'sections.studio_showcase.statement' | t }}
                {%- endif -%}
              </div>
            </div>
          </div>
          <div class="studio-editorial__caption"><div><strong>{{ artwork_label }}</strong><span>{{ garment.title | escape }}</span></div><span aria-hidden="true">↗</span></div>
          <span class="studio-editorial__start">{{ 'sections.studio_showcase.start_look' | t }} <span aria-hidden="true">→</span></span>
        </a>
      {%- endfor -%}
    </div>
    <div class="studio-editorial__footer">
      <div><p>{{ 'sections.studio_showcase.invitation' | t }}</p><span>{{ 'sections.studio_showcase.steps' | t }}</span></div>
      <a class="button" href="{{ studio_url }}">{{ 'sections.studio_showcase.enter' | t }} <span aria-hidden="true">↗</span></a>
    </div>
    <p class="studio-editorial__note">{{ 'sections.studio_showcase.sample_note' | t }}</p>
  </div>
</section>
{% stylesheet %}
  .studio-editorial { display: block; padding: 5rem 0; background: #f7f6f2; color: #1b1c18; }
  .studio-editorial__heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .studio-editorial__eyebrow { font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 1rem; }
  .studio-editorial h2 { font-size: clamp(2.4rem, 4.5vw, 5rem); line-height: 1.03; letter-spacing: -0.055em; max-width: 48rem; font-weight: 500; }
  .studio-editorial h2 em { display: block; font-family: Georgia, serif; font-weight: 400; }
  .studio-editorial__heading > p { max-width: 20rem; font-size: 0.85rem; line-height: 1.7; color: #66685e; }
  .studio-editorial__grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; }
  .studio-editorial__look { display: block; min-width: 0; }
  .studio-editorial__image { position: relative; padding: 2rem 0.75rem 1rem; background: #e8e5df; overflow: hidden; }
  .studio-editorial__look--2 .studio-editorial__image { background: #e3e6df; }
  .studio-editorial__look--3 .studio-editorial__image { background: #e5e4e0; }
  .studio-editorial__edition { position: absolute; top: 1rem; left: 1rem; z-index: 1; font-size: 0.55rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .studio-editorial__frame { position: relative; width: 100%; transition: transform 400ms; }
  .studio-editorial__garment { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  .studio-editorial__art { position: absolute; left: 50%; top: 40%; width: 24%; transform: translate(-50%,-50%); font-family: var(--font-heading); font-weight: 700; color: #fff; text-align: center; line-height: 1; }
  .studio-editorial__art img { width: 100%; height: auto; }
  .studio-editorial__art--2 { left: 38%; width: 15.6%; font-size: clamp(0.7rem,2.3vw,2.5rem); }
  .studio-editorial__art--3 { width: 33.6%; font-size: clamp(0.35rem,0.95vw,1rem); white-space: nowrap; }
  .studio-editorial__caption { display: flex; justify-content: space-between; padding: 1.15rem 0 0.8rem; gap: 0.5rem; }
  .studio-editorial__caption strong { display: block; font-size: 0.95rem; font-weight: 500; }
  .studio-editorial__caption div > span { display: block; margin-top: 0.35rem; color: #68695f; font-size: 0.65rem; }
  .studio-editorial__start { display: flex; justify-content: space-between; padding: 0.7rem 0; border-top: 1px solid #cfcec5; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .studio-editorial__look:hover .studio-editorial__frame { transform: scale(1.025); }
  .studio-editorial__footer { display: flex; align-items: center; justify-content: space-between; gap: 2rem; border-top: 1px solid #cfcec5; margin-top: 2rem; padding-top: 2rem; }
  .studio-editorial__footer p { font-size: 1.25rem; letter-spacing: -0.025em; }
  .studio-editorial__footer div > span { display: block; margin-top: 0.5rem; font-size: 0.7rem; color: #68695f; }
  .studio-editorial__footer .button { min-width: 15rem; display: flex; justify-content: space-between; gap: 2rem; }
  .studio-editorial__note { margin-top: 1.2rem; font-size: 0.6rem; color: #68695f; }
  .studio-editorial a:focus-visible { outline: 2px solid #4d5a3e; outline-offset: 5px; }
  @media(max-width: 749px) {
    .studio-editorial { padding: 3rem 0; }
    .studio-editorial__heading { display: block; margin-bottom: 1.5rem; }
    .studio-editorial__heading > p { margin-top: 1rem; }
    .studio-editorial__grid { grid-template-columns: repeat(3,85%); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 0.75rem; }
    .studio-editorial__look { scroll-snap-align: start; }
    .studio-editorial__art--2 { font-size: 1.8rem; }
    .studio-editorial__art--3 { font-size: 0.65rem; }
    .studio-editorial__footer { display: block; margin-top: 1rem; padding-top: 1.5rem; }
    .studio-editorial__footer .button { width: 100%; margin-top: 1.25rem; }
  }
  @media(prefers-reduced-motion: reduce) { .studio-editorial__frame { transition: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Homepage custom studio",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The KA Custom Studio" },
    { "type": "text", "id": "heading_solid", "label": "Heading", "default": "Made by us." },
    { "type": "text", "id": "heading_outline", "label": "Italic heading", "default": "Made yours" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Your piece. Your perspective. Start with a silhouette, add your artwork, and make it personal." },
    { "type": "text", "id": "button_label", "label": "Studio button", "default": "Continue in studio" },
    { "type": "url", "id": "studio_link", "label": "Design studio page", "info": "Defaults to /pages/design-studio." },
    { "type": "url", "id": "link", "label": "Browse garments page", "info": "Defaults to /pages/create-your-own." },
    { "type": "text", "id": "trust_note", "label": "Footer note", "default": "Signature artwork. A personal point of view." },
    { "type": "image_picker", "id": "shirt_image", "label": "Featured washed hoodie photo", "info": "Used for the Washed Hoodie when its garment block has no photo." }
  ],
  "blocks": [
    {
      "type": "canvas",
      "name": "Garment",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "Washed Hoodie" },
        { "type": "select", "id": "canvas_key", "label": "Studio garment", "default": "washed-hoodie", "options": [
          { "value": "washed-hoodie", "label": "Washed Hoodie" },
          { "value": "classic-hoodie", "label": "Classic Hoodie" },
          { "value": "classic-tee", "label": "Classic Tee" },
          { "value": "classic-polo", "label": "Classic Polo" },
          { "value": "classic-sweater", "label": "Classic Sweater" }
        ] },
        { "type": "product", "id": "product", "label": "Product", "info": "Shows the real price and availability. Match this to the studio's garment." },
        { "type": "image_picker", "id": "photo", "label": "Front photo", "info": "Use the same photo as the design studio for an exact preview." },
        { "type": "text", "id": "colorway", "label": "Studio colorway", "info": "Optional. Match the colorway name in the studio." }
      ]
    },
    {
      "type": "design",
      "name": "Motif",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "Cross", "info": "Use the same motif name in the design studio." },
        { "type": "image_picker", "id": "image", "label": "Artwork", "info": "Use the same transparent artwork as the design studio. Without artwork, the built-in studio motifs are shown." }
      ]
    }
  ],
  "presets": [{ "name": "Homepage custom studio", "blocks": [{ "type": "canvas" }] }]
}
{% endschema %}
