{%- liquid
  assign designer_url = section.settings.designer_url | default: '/pages/design-studio'
  assign handles = 'vintage-washed-frayed-hem-hoodie,oversize-fleeced-hoodie,essential-cotton-t-shirt,two-tone-fleeced-varsity-jacket,women-s-mineral-wash-cotton-crop-t-shirt' | split: ','
-%}
<div class="page-width section studio-picker">
  <div class="picker__header">
    <h1 class="picker__title">{{ section.settings.heading | escape }}</h1>
    <p class="picker__subtext">{{ section.settings.subtext | escape }}</p>
  </div>
  <div class="studio-picker__grid">
    {%- for handle in handles -%}
      {%- assign garment = all_products[handle] -%}
      {%- if garment != blank -%}
        <a class="studio-picker__card" href="{{ designer_url }}?canvas={{ handle }}">
          <div class="studio-picker__photo">{{ garment.featured_image | image_url: width: 900 | image_tag: alt: garment.title, widths: '300,600,900', sizes: '(min-width: 750px) 30vw, 80vw', loading: 'lazy' }}</div>
          <h2>{{ garment.title | escape }}</h2>
          <p>{{ garment.price | money }}</p>
          <span>{{ 'sections.studio_showcase.customize' | t }} <span aria-hidden="true">↗</span></span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{% stylesheet %}
  .studio-picker__grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 2rem 1rem; }
  .studio-picker__photo { background: #eeede8; overflow: hidden; }
  .studio-picker__photo img { display: block; width: 100%; height: auto; mix-blend-mode: multiply; transition: transform 300ms; }
  .studio-picker__card:hover img { transform: scale(1.025); }
  .studio-picker__card h2 { font-size: 1rem; margin: 1rem 0 0.5rem; }
  .studio-picker__card > p { font-size: 0.8rem; margin-bottom: 1rem; }
  .studio-picker__card > span { display: flex; justify-content: space-between; padding-top: 0.75rem; border-top: 1px solid #d8d8d2; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .studio-picker__card:focus-visible { outline: 2px solid #4d5a3e; outline-offset: 5px; }
  @media(max-width:749px) { .studio-picker__grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .studio-picker__card h2 { font-size: 0.8rem; } }
  @media(prefers-reduced-motion:reduce) { .studio-picker__photo img { transition: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Customizer picker",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your canvas" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Pick the piece you want to customize — then make it yours in the design studio." },
    { "type": "text", "id": "tee_row_heading", "label": "Shirts row heading", "default": "Shirts" },
    { "type": "text", "id": "hoodie_row_heading", "label": "Hoodies row heading", "default": "Hoodies" },
    { "type": "text", "id": "card_cta", "label": "Card call to action", "default": "Customize this" },
    { "type": "url", "id": "designer_url", "label": "Designer page", "info": "Defaults to /pages/design-studio" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Garment",
      "settings": [
        {
          "type": "select",
          "id": "garment",
          "label": "Garment type",
          "options": [
            { "value": "tee", "label": "Shirt" },
            { "value": "hoodie", "label": "Hoodie" }
          ],
          "default": "tee"
        },
        { "type": "text", "id": "label", "label": "Name", "info": "Must match the canvas name in the Designer page's section so clicking this card opens the right garment.", "default": "Classic Tee" },
        {
          "type": "header",
          "content": "Colorways",
          "info": "Add a photo per colorway. Cards with more than one show swatches and flash between them; picking a swatch carries that colorway into the designer. Names should match the colorway names on the matching Designer canvas."
        },
        { "type": "text", "id": "color_1_name", "label": "Colorway 1 name", "default": "Standard" },
        { "type": "image_picker", "id": "image", "label": "Colorway 1 photo", "info": "Plain, front-facing photo (flat lay works best) — the design animation plays on top of it." },
        { "type": "text", "id": "color_2_name", "label": "Colorway 2 name" },
        { "type": "image_picker", "id": "image_2", "label": "Colorway 2 photo" },
        { "type": "text", "id": "color_3_name", "label": "Colorway 3 name" },
        { "type": "image_picker", "id": "image_3", "label": "Colorway 3 photo" },
        { "type": "text", "id": "color_4_name", "label": "Colorway 4 name" },
        { "type": "image_picker", "id": "image_4", "label": "Colorway 4 photo" }
      ]
    },
    {
      "type": "design",
      "name": "Design",
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "Logo" },
        { "type": "image_picker", "id": "image", "label": "Design image", "info": "Transparent PNGs work best. Shared by every card's animation." }
      ]
    }
  ]
}
{% endschema %}
