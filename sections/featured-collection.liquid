{%- liquid
  assign collection = collections[section.settings.collection]
  assign product_types = collection.products | map: 'type' | uniq
-%}

<section class="editorial-collection" style="--editorial-image-fit: {{ section.settings.image_fit }};">
  <div class="page-width editorial-collection__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="editorial-collection__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="editorial-collection__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="editorial-collection__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_filters and product_types.size > 0 -%}
      <filter-tabs class="filter-tabs" role="tablist" aria-label="{{ 'collections.general.filter_by' | t }}">
        <button type="button" class="filter-tab" data-filter="all" aria-current="true">{{ 'collections.general.view_all' | t }}</button>
        {%- for type in product_types -%}
          {%- unless type == blank -%}
            <button type="button" class="filter-tab" data-filter="{{ type | handleize }}" aria-current="false">{{ type }}</button>
          {%- endunless -%}
        {%- endfor -%}
      </filter-tabs>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <div class="product-grid editorial-collection__grid" style="--grid-columns: {{ section.settings.columns }};">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {%- liquid
            assign is_priority = false
            if section.index <= 2 and forloop.index <= 4
              assign is_priority = true
            endif
          -%}
          <div class="product-grid__item" data-product-type="{{ product.type | handleize }}">
            {%- render 'product-card', product: product, show_new_badge: section.settings.show_new_badge, priority: is_priority, first: forloop.first, quick_add_style: 'button' -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="editorial-collection__placeholder-grid" aria-hidden="true">
        {%- for i in (1..4) -%}
          <div class="editorial-collection__placeholder-card">
            {{ 'product-' | append: i | placeholder_svg_tag }}
            <span>SELECT A COLLECTION</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all -%}
      <div class="editorial-collection__footer">
        <a href="{{ routes.all_products_collection_url }}" class="editorial-collection__view-all">
          {{ section.settings.view_all_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Product image fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "contain"
    },
    { "type": "checkbox", "id": "show_filters", "label": "Show category filters", "default": false },
    { "type": "checkbox", "id": "show_new_badge", "label": "Show new badge", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view-all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "VIEW ALL PRODUCTS" }
  ],
  "presets": [
    { "name": "Editorial collection" }
  ]
}
{% endschema %}
