<section class="customizer-promo customizer-promo--{{ section.settings.color_scheme }}">
  <div class="page-width customizer-promo__inner">
    <div class="customizer-promo__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="customizer-promo__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="customizer-promo__heading">
        {{ section.settings.heading_solid }}
        <span class="customizer-promo__heading-outline">{{ section.settings.heading_outline }}</span>
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="customizer-promo__text">{{ section.settings.text }}</p>
      {%- endif -%}

      <ol class="customizer-promo__steps">
        <li><span>01</span>{{ section.settings.step_1 }}</li>
        <li><span>02</span>{{ section.settings.step_2 }}</li>
        <li><span>03</span>{{ section.settings.step_3 }}</li>
      </ol>

      <div class="customizer-promo__action">
        <a href="{{ section.settings.link | default: '/pages/create-your-own' }}" class="button customizer-promo__button">
          {{ section.settings.button_label }}
          <span aria-hidden="true">&rarr;</span>
        </a>
        {%- if section.settings.trust_note != blank -%}
          <p class="customizer-promo__trust">{{ section.settings.trust_note }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="customizer-promo__visual">
      {%- if section.settings.shirt_image != blank -%}
        <showcase-demo
          class="showcase"
          data-zone="{{ section.settings.zone_x | default: 50 }},{{ section.settings.zone_y | default: 42 }},{{ section.settings.zone_w | default: 32 }},{{ section.settings.zone_h | default: 28 }}"
        >
          <script type="application/json" data-demo-designs>
            [
              {%- for block in section.blocks -%}
                {%- if block.type == 'design' and block.settings.image != blank -%}
                  { "src": {{ block.settings.image | image_url: width: 300 | json }} },
                {%- endif -%}
              {%- endfor -%}
              null
            ]
          </script>

          <div class="showcase__stage" data-demo-stage>
            {{ section.settings.shirt_image
              | image_url: width: 900
              | image_tag:
                alt: section.settings.shirt_image.alt,
                class: 'showcase__shirt',
                widths: '420, 600, 750, 900',
                sizes: '(min-width: 990px) 42vw, (min-width: 750px) 48vw, calc(100vw - 2rem)',
                loading: 'lazy'
            }}
            <div class="showcase__layer" data-demo-placements></div>
          </div>

          <div class="showcase__tray" aria-hidden="true">
            {%- for block in section.blocks -%}
              {%- if block.type == 'design' and block.settings.image != blank -%}
                <span class="showcase__chip" data-demo-chip {{ block.shopify_attributes }}>
                  {{ block.settings.image
                    | image_url: width: 150
                    | image_tag: alt: '', loading: 'lazy', width: 150
                  }}
                </span>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="showcase__cursor" data-demo-cursor aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26">
              <path d="M4 2 L4 20 L9 15.5 L12.5 22 L15.5 20.5 L12 14 L19 13.5 Z" fill="#111" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/>
            </svg>
          </div>
        </showcase-demo>

        <script src="{{ 'customizer-promo.js' | asset_url }}" type="module"></script>
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image
          | image_url: width: 900
          | image_tag:
            alt: section.settings.image.alt,
            widths: '420, 600, 750, 900',
            sizes: '(min-width: 990px) 42vw, (min-width: 750px) 48vw, calc(100vw - 2rem)',
            loading: 'lazy'
        }}
      {%- else -%}
        <svg viewBox="0 0 400 460" aria-hidden="true" class="customizer-promo__tee">
          <path d="M118 60 L62 92 L20 210 L92 240 L108 196 L108 420 Q200 442 292 420 L292 196 L308 240 L380 210 L338 92 L282 60 Q252 34 200 36 Q148 34 118 60 Z" fill="#ffffff" stroke="rgb(0 0 0 / 20%)" stroke-width="2"/>
          <path d="M154 52 Q200 78 246 52" fill="none" stroke="rgb(0 0 0 / 25%)" stroke-width="6" stroke-linecap="round"/>
          <text x="200" y="235" text-anchor="middle" font-size="34" font-weight="700" fill="currentColor" opacity="0.85">YOUR</text>
          <text x="200" y="275" text-anchor="middle" font-size="34" font-weight="700" fill="currentColor" opacity="0.85">DESIGN</text>
        </svg>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customizer promo",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "light", "label": "Light" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "KA Design Studio" },
    { "type": "text", "id": "heading_solid", "label": "Heading (solid)", "default": "Make it" },
    { "type": "text", "id": "heading_outline", "label": "Heading (outlined)", "default": "your own" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose the piece. Place the artwork. Finish with a one-of-one design made by you." },
    { "type": "text", "id": "step_1", "label": "Step 1", "default": "Choose your piece" },
    { "type": "text", "id": "step_2", "label": "Step 2", "default": "Build your design" },
    { "type": "text", "id": "step_3", "label": "Step 3", "default": "Wear the only one" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Create yours" },
    { "type": "url", "id": "link", "label": "Button link", "info": "Defaults to /pages/create-your-own" },
    { "type": "text", "id": "trust_note", "label": "Note under button", "default": "No design experience needed · Secure checkout" },
    {
      "type": "image_picker",
      "id": "shirt_image",
      "label": "Shirt photo (auto-playing demo)",
      "info": "A plain, front-facing photo of a blank shirt (flat lay works best). When set, an animated cursor automatically places the designs below onto the shirt in a loop, like a video."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Static visual (fallback)",
      "info": "Only used if no shirt photo above is set. Replaces the built-in tee illustration."
    },
    {
      "type": "header",
      "content": "Print zone",
      "info": "Where designs land on the photo, as % of the image. Tune these until drops sit on the garment's chest."
    },
    { "type": "range", "id": "zone_x", "label": "Zone center — horizontal", "min": 20, "max": 80, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "zone_y", "label": "Zone center — vertical", "min": 20, "max": 80, "step": 1, "unit": "%", "default": 42 },
    { "type": "range", "id": "zone_w", "label": "Zone width", "min": 10, "max": 70, "step": 1, "unit": "%", "default": 32 },
    { "type": "range", "id": "zone_h", "label": "Zone height", "min": 10, "max": 70, "step": 1, "unit": "%", "default": 28 }
  ],
  "blocks": [
    {
      "type": "design",
      "name": "Design",
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "Logo" },
        { "type": "image_picker", "id": "image", "label": "Design image", "info": "Transparent PNGs work best." }
      ]
    }
  ],
  "presets": [
    { "name": "Customizer promo" }
  ]
}
{% endschema %}
