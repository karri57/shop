{%- doc -%}
  Inert quick-add product content. It is embedded in the product page inside a
  template, fetched on demand from product cards, then activated in the sheet.
  @param {object} product
{%- enddoc -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'quick-add-form-' | append: product.id
-%}

<div class="quick-add" data-quick-add-product>
  <div class="quick-add__summary">
    <a href="{{ product.url }}" class="quick-add__media">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 360 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="180"
          height="{{ 180 | divided_by: product.featured_image.aspect_ratio | default: 220 }}"
          loading="eager"
          data-quick-add-image
        >
      {%- endif -%}
    </a>
    <div class="quick-add__summary-copy">
      <a href="{{ product.url }}" class="quick-add__title">{{ product.title }}</a>
      <div class="quick-add__price" data-product-price>{%- render 'price', product: current_variant -%}</div>
    </div>
  </div>

  <product-form class="quick-add__product-form">
    {%- form 'product', product, id: product_form_id -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" ref="variantId">
      <input type="hidden" name="quantity" value="1">

      {%- if product.has_only_default_variant == false -%}
        <variant-picker>
          <script type="application/json" data-variant-json>
            {{ product.variants | json }}
          </script>

          {%- for option in product.options_with_values -%}
            <fieldset class="quick-add__option product__option" data-option-index="{{ forloop.index0 }}">
              <span class="quick-add__option-name product__option-name">{{ option.name }}</span>
              <div class="quick-add__values swatch-list">
                {%- for value in option.values -%}
                  <label
                    class="quick-add__value swatch"
                    data-value="{{ value | escape }}"
                    aria-current="{% if current_variant.options[forloop.parentloop.index0] == value %}true{% else %}false{% endif %}"
                  >
                    <input
                      type="radio"
                      name="option-{{ forloop.parentloop.index0 }}"
                      value="{{ value | escape }}"
                      class="visually-hidden"
                      {% if current_variant.options[forloop.parentloop.index0] == value %}checked{% endif %}
                    >
                    {{ value }}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </variant-picker>
      {%- endif -%}

      <span class="form-error" data-form-error role="alert" aria-live="polite" hidden></span>

      <button
        type="submit"
        class="button button--full quick-add__submit"
        data-add-to-cart-button
        {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
      >
        {% render 'icon', name: 'add-to-cart' %}
        <span data-add-to-cart-text>
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>

      <div class="quick-add__accelerated-checkout">
        {{ form | payment_button }}
      </div>
    {%- endform -%}
  </product-form>
</div>
